# SOMENTE desenvolvimento local. Nunca reutilizar estas credenciais em produção.
DATABASE_URL=postgresql://wager_app:local-app-only@localhost:55432/wagering
MIGRATION_DATABASE_URL=postgresql://wager_migrator:local-migrator-only@localhost:55432/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OIDC_ISSUER=http://localhost:8180/realms/wagering
OIDC_AUDIENCE=wagering-api
PORT=3000
API_BASE_URL=http://localhost:3000
REQUEST_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/wager-transactions.fifo
REQUEST_DLQ_URL=http://localhost:4566/queue/us-east-1/000000000000/wager-transactions-dlq.fifo
EVENT_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/wager-events.fifo
WORKER_CONSUMER_NAME=wagering-transactions
WORKER_VISIBILITY_SECONDS=30
WORKER_HEARTBEAT_MS=10000
WORKER_SHUTDOWN_GRACE_MS=25000
# Somente quando executado no container; o Compose configura esse endereço internamente.
# OIDC_JWKS_URI=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs

# Serviços isolados de testes; não apontar estes valores para ambiente real.
