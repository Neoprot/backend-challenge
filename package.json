{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11 <2"
  },
  "scripts": {
    "setup:env": "bun scripts/setup-env.ts",
    "demo:http": "bun scripts/demo-http.ts",
    "start": "bun src/workers/main.ts",
    "start:http": "bun src/bootstrap/main.ts",
    "start:workers": "bun src/workers/main.ts",
    "start:dev": "bun --watch src/workers/main.ts",
    "seed:local": "bun scripts/seed-local.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test/unit",
    "test:it": "bun scripts/run-integration.ts",
    "test:concurrency": "bun scripts/run-concurrency.ts",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
