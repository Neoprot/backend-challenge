{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": { "realm": [{ "name": "wagering-admin" }, { "name": "wagering-provider" }] },
  "clients": [
    { "clientId": "wagering-api", "bearerOnly": true, "protocol": "openid-connect" },
    {
      "clientId": "provider-aurora",
      "secret": "local-aurora-only",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "provider-identity", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "config": { "claim.name": "providerId", "claim.value": "aurora", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" } }
      ]
    },
    {
      "clientId": "provider-horizonte",
      "secret": "local-horizonte-only",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "provider-identity", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "config": { "claim.name": "providerId", "claim.value": "horizonte", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" } }
      ]
    },
    {
      "clientId": "operations-console",
      "secret": "local-operations-only",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false" } }
      ]
    }
  ],
  "users": [
    { "username": "service-account-provider-aurora", "enabled": true, "serviceAccountClientId": "provider-aurora", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-provider-horizonte", "enabled": true, "serviceAccountClientId": "provider-horizonte", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-operations-console", "enabled": true, "serviceAccountClientId": "operations-console", "realmRoles": ["wagering-admin"] }
  ]
}
